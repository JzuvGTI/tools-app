<script>
    // Mobile Menu Toggle
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileMenuToggle.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
    });

    // Anime.js untuk Animasi Judul dan Deskripsi
    anime({
        targets: '.animate__title',
        translateY: [-50, 0],
        opacity: [0, 1],
        duration: 1000,
        easing: 'easeOutQuad'
    });
    anime({
        targets: '.animate__description',
        translateY: [50, 0],
        opacity: [0, 1],
        duration: 1000,
        delay: 300,
        easing: 'easeOutQuad'
    });

    // Three.js Interconnected Cubes Animation
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ canvas: document.getElementById("cell-canvas"), alpha: true });

    // Optimize pixel ratio for low-spec devices
    const isLowSpec = window.innerWidth < 768 || window.devicePixelRatio > 2;
    renderer.setPixelRatio(isLowSpec ? 1 : Math.min(window.devicePixelRatio, 1.5));
    renderer.setSize(window.innerWidth, window.innerHeight);

    // Adjust cube count based on device
    const cubeCount = isLowSpec ? 10 : 20; // Reduced cube count
    const cubeSize = 0.3;
    const maxDistance = 3;
    const maxConnectionsPerCube = 3; // Limit connections per cube
    const cubeMaterial = new THREE.MeshBasicMaterial({ color: 0x00ffff, wireframe: true });
    const lineMaterial = new THREE.LineBasicMaterial({ color: 0x4bffa5, transparent: true, opacity: 0.3 }); // Lower opacity for less GPU load

    const cubes = [];
    class Cube {
        constructor() {
            this.geometry = new THREE.BoxGeometry(cubeSize, cubeSize, cubeSize);
            this.mesh = new THREE.Mesh(this.geometry, cubeMaterial);
            this.mesh.position.set(
                (Math.random() - 0.5) * 10,
                (Math.random() - 0.5) * 10,
                (Math.random() - 0.5) * 10
            );
            this.velocity = new THREE.Vector3(
                (Math.random() - 0.5) * 0.01, // Slower velocity
                (Math.random() - 0.5) * 0.01,
                (Math.random() - 0.5) * 0.01
            );
            scene.add(this.mesh);
        }

        update() {
            this.mesh.position.add(this.velocity);
            if (Math.abs(this.mesh.position.x) > 5) this.velocity.x *= -1;
            if (Math.abs(this.mesh.position.y) > 5) this.velocity.y *= -1;
            if (Math.abs(this.mesh.position.z) > 5) this.velocity.z *= -1;
            this.mesh.rotation.x += 0.005; // Slower rotation
            this.mesh.rotation.y += 0.005;
        }
    }

    for (let i = 0; i < cubeCount; i++) {
        cubes.push(new Cube());
    }

    function animate() {
        requestAnimationFrame(animate);
        cubes.forEach(cube => cube.update());

        // Remove old lines
        scene.children = scene.children.filter(child => !(child instanceof THREE.Line));

        // Optimized line connections
        for (let i = 0; i < cubes.length; i++) {
            let connections = 0;
            for (let j = 0; j < cubes.length && connections < maxConnectionsPerCube; j++) {
                if (i !== j) {
                    const distance = cubes[i].mesh.position.distanceTo(cubes[j].mesh.position);
                    if (distance < maxDistance) {
                        const geometry = new THREE.BufferGeometry().setFromPoints([
                            cubes[i].mesh.position,
                            cubes[j].mesh.position
                        ]);
                        const line = new THREE.Line(geometry, lineMaterial);
                        scene.add(line);
                        connections++;
                    }
                }
            }
        }

        scene.rotation.y += 0.001; // Slower scene rotation
        renderer.render(scene, camera);
    }

    camera.position.z = isLowSpec ? 12 : 8; // Further camera distance for low-spec devices
    animate();

    // Debounced resize handler
    let resizeTimeout;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
            renderer.setSize(window.innerWidth, window.innerHeight);
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
        }, 100); // Debounce for 100ms
    });
</script>