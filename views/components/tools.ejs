<!-- views/partials/tools.ejs -->
<section id="tools" class="py-16">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-cyan-300">Tools Kami</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Downloader -->
      <div class="bg-cyan-900/10 backdrop-blur-md p-6 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 group border-2 border-cyan-500">
        <i class="fas fa-download text-4xl text-cyan-400 mb-4"></i>
        <h3 class="text-xl font-semibold mb-2 text-cyan-300">Downloader</h3>
        <p class="text-gray-300 mb-4">Unduh video, musik, dan dokumen dengan mudah dari berbagai platform.</p>
        <div class="flex justify-between items-center">
          <a href="/downloader" class="inline-block px-4 py-2 border border-cyan-500 text-cyan-400 rounded-full group-hover:bg-cyan-500/20 group-hover:text-cyan-200 transition-all duration-300">Coba Sekarang</a>
          <div class="flex items-center gap-2 border border-green-400 rounded-full px-2 py-1">
            <span class="w-3 h-3 bg-green-400 rounded-full border border-green-400 animate-pulse" title="Service is active"></span>
            <span class="text-sm text-green-400 font-semibold">AKTIF</span>
          </div>
        </div>
      </div>
      <!-- Searcher -->
      <div class="bg-cyan-900/10 backdrop-blur-md p-6 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 group border-2 border-yellow-500">
        <i class="fas fa-search text-4xl text-yellow-400 mb-4"></i>
        <h3 class="text-xl font-semibold mb-2 text-yellow-300">Searcher</h3>
        <p class="text-gray-300 mb-4">Cari apa saja dengan cepat dan akurat menggunakan sistem cerdas kami.</p>
        <div class="flex justify-between items-center">
          <a href="/searcher" class="inline-block px-4 py-2 border border-yellow-500 text-yellow-400 rounded-full group-hover:bg-yellow-500/20 group-hover:text-yellow-200 transition-all duration-300">Coba Sekarang</a>
          <div class="flex items-center gap-2 border border-green-400 rounded-full px-2 py-1">
            <span class="w-3 h-3 bg-green-400 rounded-full border border-green-400 animate-pulse" title="Service is active"></span>
            <span class="text-sm text-green-400 font-semibold">AKTIF</span>
          </div>
        </div>
      </div>
      <!-- Cloud Storage -->
      <div class="bg-cyan-900/10 backdrop-blur-md p-6 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 group border-2 border-purple-500">
        <i class="fas fa-cloud text-4xl text-purple-400 mb-4"></i>
        <h3 class="text-xl font-semibold mb-2 text-purple-300">Cloud Storage</h3>
        <p class="text-gray-300 mb-4">Simpan file dengan aman dan akses kapan saja, di mana saja.</p>
        <div class="flex justify-between items-center">
          <a href="/cloud" class="inline-block px-4 py-2 border border-purple-500 text-purple-400 rounded-full group-hover:bg-purple-500/20 group-hover:text-purple-200 transition-all duration-300">Coba Sekarang</a>
          <div class="flex items-center gap-2 border border-red-500 rounded-full px-2 py-1">
            <span class="w-3 h-3 bg-red-500 rounded-full border border-red-500 animate-pulse" title="Service is inactive"></span>
            <span class="text-sm text-red-500 font-semibold">NONAKTIF</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>