<!-- views/partials/header.ejs -->
<header class="fixed top-0 w-full bg-black/20 backdrop-blur-lg shadow-lg z-50 transition-all duration-300 md:rounded-none rounded-xl mx-2 mt-2 md:mx-0 md:mt-0">
  <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
    <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-cyan-400">JzTools</h1>
    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-4 lg:space-x-6">
      <a href="#features" class="hover:text-cyan-300 transition-colors text-sm">Fitur</a>
      <a href="#tools" class="hover:text-cyan-300 transition-colors text-sm">Tools</a>
      <a href="#footer" class="hover:text-cyan-300 transition-colors text-sm">Tentang</a>
      <!-- Language Selector -->
      <select id="language-selector" class="bg-transparent border border-cyan-400 rounded px-2 py-1 text-sm text-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-400">
        <option value="en">English</option>
        <option value="id">Bahasa Indonesia</option>
      </select>
      <!-- Theme Toggle -->
      <button id="theme-toggle" class="p-2 rounded-full border border-cyan-400 text-cyan-400 hover:bg-cyan-400/20 hover:text-cyan-200 transition-colors">
        <i class="fas fa-moon"></i>
      </button>
    </nav>
    <!-- Mobile Menu Button -->
    <button id="mobile-menu-toggle" class="md:hidden p-2 rounded-full border border-cyan-400 text-cyan-400 hover:bg-cyan-400/20 hover:text-cyan-200 transition-colors">
      <i class="fas fa-bars"></i>
    </button>
  </div>
  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-black/20 backdrop-blur-lg rounded-b-xl mx-2 p-4 space-y-2">
    <a href="#features" class="block py-2 text-sm hover:text-cyan-300 transition-colors">Fitur</a>
    <a href="#tools" class="block py-2 text-sm hover:text-cyan-300 transition-colors">Tools</a>
    <a href="#footer" class="block py-2 text-sm hover:text-cyan-300 transition-colors">Tentang</a>
    <select id="mobile-language-selector" class="w-full bg-transparent border border-cyan-400 rounded px-2 py-1 text-sm text-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-400">
      <option value="en">English</option>
      <option value="id">Bahasa Indonesia</option>
    </select>
  </div>
</header>